# 인증서가 있을 때 — 80 은 인증서 확인 + https 로 넘기기, 443 은 app 으로 전달
# ${DOMAIN} 만 start.sh 의 envsubst 로 채운다 (nginx 변수 $host 등은 그대로)
# DOMAIN 은 도메인 또는 IP. IP 로 접속하면 SNI 가 없으므로 default_server 로 받는다.
# 인증서 이름은 항상 "agc" (certbot --cert-name agc) — 도메인·IP 가 바뀌어도 경로는 그대로.

server {
    listen 80 default_server;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/agc/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agc/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 50m;       # 상세 이미지 조각 합계 45MB(네이버 PNG 무손실) + 여유 · 사진 업로드 10MB

    # MKT BE (C:\Users\iwill\MKT\BE, 컨테이너 mkt_app) — 같은 PC · 같은 인증서로 /mkt/ 아래를 넘긴다 (2026-10-26).
    #   이름은 요청 때 찾는다(resolver) → MKT 가 꺼져 있어도 AGC nginx 는 뜨고, /mkt/ 만 502.
    location /mkt/ {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $mkt_upstream http://mkt_app:8000;
        rewrite ^/mkt/(.*)$ /$1 break;
        proxy_pass $mkt_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        # 'app' 은 같은 네트워크(be_default)의 MKT 컨테이너(mkt_app)도 서비스 이름으로 갖고 있어 둘로 나뉘어 간다 → 컨테이너 이름으로 고정
        proxy_pass http://agc_app:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
