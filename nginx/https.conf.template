# 인증서가 있을 때 — 80 은 인증서 확인 + https 로 넘기기, 443 은 app 으로 전달
# ${DOMAIN} 만 start.sh 의 envsubst 로 채운다 (nginx 변수 $host 등은 그대로)
# DOMAIN 은 도메인 또는 IP. IP 로 접속하면 SNI 가 없으므로 default_server 로 받는다.
# 인증서 이름은 항상 "agc" (certbot --cert-name agc) — 도메인·IP 가 바뀌어도 경로는 그대로.

server {
    listen 80 default_server;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/agc/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agc/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 50m;       # 상세 이미지 조각 합계 45MB(네이버 PNG 무손실) + 여유 · 사진 업로드 10MB

    # MKT BE (C:\Users\iwill\MKT\BE, 컨테이너 mkt_app) — 같은 PC · 같은 인증서로 /mkt/ 아래를 넘긴다 (2026-10-26).
    #   이름은 요청 때 찾는다(resolver = Docker 내장 DNS) → MKT 가 꺼져 있어도 AGC nginx 는 뜨고, /mkt/ 만 503 JSON.
    #   MKT compose 서비스 이름은 mkt_app · mkt_db — be_default 에서 AGC 의 app · db 와 이름이 겹치지 않게 (MKT BE docker-compose.yml).
    location = /mkt {
        return 301 /mkt/;
    }
    location /mkt/ {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $mkt_upstream http://mkt_app:8000;
        rewrite ^/mkt/(.*)$ /$1 break;          # /mkt/health?x=1 → /health?x=1 (쿼리는 그대로)
        proxy_pass $mkt_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;               # 꺼져 있으면 오래 기다리지 않고 바로 알린다
        proxy_read_timeout 60s;
        # nginx 가 만든 502·504(MKT 꺼짐·응답 없음)만 바꾼다. MKT 가 직접 낸 4xx·5xx 는 그대로 (proxy_intercept_errors off)
        error_page 502 504 = @mkt_down;
    }
    location @mkt_down {
        default_type "application/json; charset=utf-8";
        return 503 '{"detail":"MKT 서버가 꺼져 있어요"}';
    }

    # SHOP BE — 자사몰 eidofood.com (C:\Users\iwill\SHOP\BE, 컨테이너 shop_app) — /shop/ 아래를 넘긴다 (2026-10-27).
    #   MKT 와 같은 방식: 요청 때 이름을 찾아 SHOP 이 꺼져 있어도 AGC nginx 는 뜨고, /shop/ 만 503 JSON.
    #   결제 승인·취소는 결제사 응답을 60초까지 기다려야 해서 read 는 90초.
    location = /shop {
        return 301 /shop/;
    }
    location /shop/ {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $shop_upstream http://shop_app:8000;
        rewrite ^/shop/(.*)$ /$1 break;
        proxy_pass $shop_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 90s;
        error_page 502 504 = @shop_down;
    }
    location @shop_down {
        default_type "application/json; charset=utf-8";
        return 503 '{"detail":"자사몰 서버가 꺼져 있어요"}';
    }

    location / {
        # 'app' 은 같은 네트워크(be_default)의 MKT 컨테이너도 서비스 이름으로 갖고 있어 둘로 나뉘어 갔다 → 컨테이너 이름으로 고정.
        #   (2026-10-26 MKT 서비스 이름을 mkt_app 으로 바꿔 원인은 없어졌지만, 다른 서비스가 붙어도 안전하게 고정은 유지)
        proxy_pass http://agc_app:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
